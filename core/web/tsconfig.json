{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": [],
		"baseUrl": ".",
		"paths": {
			"@atrium/ui": ["./ui/index.tsx"],
			"@atrium/sdk": ["./sdk/index.ts"],
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"]
		}
	},
	"include": ["ui", "sdk", "shell", "../../apps/*/web/**/*.ts", "../../apps/*/web/**/*.tsx"],
	"exclude": ["../../apps/*/web/dist"]
}
