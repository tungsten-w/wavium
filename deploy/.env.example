# Copy this file to .env and replace every CHANGE_ME value before starting.
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD

# Run `docker network ls` to find the network used by Nginx Proxy Manager.
NPM_NETWORK=npm_default

# Docker private-network ranges are trusted because NPM connects over Docker.
TRUSTED_PROXIES=172.16.0.0/12
PHP_MEMORY_LIMIT=512M
PHP_UPLOAD_LIMIT=10G
