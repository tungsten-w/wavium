# Wavium: copy to .env and fill in. Never commit .env.

# Public name of the server (DNS must point here). "localhost" = local test with Caddy's own CA.
WAVIUM_DOMAIN=wavium.example.org

# First admin account, created on the first start.
WAVIUM_ADMIN_USER=admin
WAVIUM_ADMIN_PASSWORD=change-me-to-a-long-password
# Database password (any long random string).
WAVIUM_DB_PASSWORD=change-me-too

# Image built with: WITH_DAILY_TODO=1 ATRIUM_TAG=wavium bash deploy/build.sh
WAVIUM_IMAGE=atrium:wavium

# Ports Caddy listens on (and the address; 127.0.0.1 for a local test).
WAVIUM_BIND=0.0.0.0
WAVIUM_HTTP_PORT=80
WAVIUM_HTTPS_PORT=443
# "acme" = Let's Encrypt (needs a public name and ports 80/443 reachable).
# "internal" = Caddy's own certificate, for a home network or an IP address:
# the browser warns once. See "On a local network" in README.md.
WAVIUM_TLS_ISSUER=acme
# Only when the HTTPS port is not 443, e.g. ":8443", so links include it.
WAVIUM_PUBLIC_PORT_SUFFIX=

WAVIUM_TIMEZONE=Europe/Paris
# Optional push notifications (approvals, morning digest) through ntfy.
WAVIUM_NTFY_URL=
WAVIUM_NTFY_TOKEN=
# Agent webhooks to private addresses (comma list), empty = none.
WAVIUM_WEBHOOK_ALLOW=

# Resources (a small server: 2 cores, 4 GB).
WAVIUM_APP_CPUS=2.0
WAVIUM_APP_MEM=2g
WAVIUM_CRON_CPUS=1.0
WAVIUM_CRON_MEM=1g
WAVIUM_DB_CPUS=1.5
WAVIUM_DB_MEM=1g
WAVIUM_PHP_MEMORY=512M
WAVIUM_UPLOAD_LIMIT=10G
