# Wavium behind Caddy: automatic HTTPS for WAVIUM_DOMAIN (Let's Encrypt, or
# Caddy's local CA for "localhost"). Bun in the app container serves everything.
# To get Let's Encrypt notices, add a global block at the top:
#   {
#   	email you@example.org
#   }

# Local-network install (WAVIUM_DOMAIN is an IP or a name with no public DNS):
# set WAVIUM_TLS_ISSUER=internal to get a certificate from Caddy's own CA
# instead of Let's Encrypt, which cannot issue for either.
{
	# Caddy must know the ports the outside world uses, not just the ones it
	# listens on: its automatic HTTP->HTTPS redirect is built from these. Left
	# unset on an alternate-port install, the redirect drops the port and sends
	# visitors to :443, i.e. whatever else runs there.
	http_port {$WAVIUM_HTTP_PORT:80}
	https_port {$WAVIUM_HTTPS_PORT:443}

	# A client connecting to a bare IP sends no SNI (forbidden for IP literals),
	# so Caddy has no name to match a certificate against and aborts the
	# handshake. This names the certificate to serve when SNI is absent. It
	# only takes effect on an existing connection policy, which is why the site
	# below always declares `tls`, public install included.
	default_sni {$WAVIUM_DOMAIN}
}

# Caddy's own HTTP->HTTPS redirect builds its target without the HTTPS port,
# which on an alternate-port install points at whatever runs on :443. Spell the
# redirect out instead. On a default install the suffix is empty, so this is
# the same redirect Caddy would have made.
http://{$WAVIUM_DOMAIN} {
	redir https://{$WAVIUM_DOMAIN}{$WAVIUM_PUBLIC_PORT_SUFFIX}{uri} 308
}

{$WAVIUM_DOMAIN} {
	tls {
		issuer {$WAVIUM_TLS_ISSUER:acme}
	}
	encode zstd gzip
	# Nextcloud clients find CalDAV/CardDAV here.
	redir /.well-known/carddav /remote.php/dav/ 301
	redir /.well-known/caldav /remote.php/dav/ 301
	header {
		Strict-Transport-Security "max-age=31536000"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		-Server
	}
	request_body {
		max_size 10GB
	}
	reverse_proxy app:80 {
		# Large uploads and long DAV syncs.
		transport http {
			read_timeout 1h
			write_timeout 1h
		}
	}
}
