# Atrium dev stack settings (compose.yaml). Copy to .env to change anything;
# every value below is already the default, so .env is optional.
# DEV ONLY: never put real secrets, real mail accounts or real API keys here.

# Compose project and port: change both to run a second checkout (worktree).
COMPOSE_PROJECT_NAME=atrium-dev
ATRIUM_PORT=8092
# Extra trusted domain (the dev stack also trusts localhost and 127.0.0.1).
ATRIUM_DOMAIN=localhost

# Containers run as the repo owner so they can write config/ and data/.
# make sets these from `id -u` / `id -g`.
ATRIUM_UID=1000
ATRIUM_GID=1000

# Dev PostgreSQL (in the "db" volume; `make reset` wipes it).
ATRIUM_DB_NAME=atrium
ATRIUM_DB_USER=atrium
ATRIUM_DB_PASSWORD=atrium-dev-only

# Dev admin account. Demo users: alice / alice-demo-pass, bob / bob-demo-pass.
ATRIUM_ADMIN_USER=admin
ATRIUM_ADMIN_PASSWORD=admin-demo-pass
# 1 = load the demo accounts, mails, events, contacts and files on first start.
ATRIUM_DEMO=1

# Optional owner notifications over ntfy (topic URL). Empty = off.
ATRIUM_NTFY_URL=
# Webhook targets on internal addresses that agents may use anyway
# (comma-separated hosts or CIDRs). Empty = internal addresses refused.
ATRIUM_WEBHOOK_ALLOW=
# Largest request body the Bun server accepts, in bytes. Empty = default.
ATRIUM_MAX_BODY=
# AI providers enabled for the instance. Dev and tests: mock only.
ATRIUM_AI_PROVIDERS=mock
