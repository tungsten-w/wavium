<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 bootstrap="bootstrap.php"
		 colors="false"
		 cacheDirectory="/tmp/atrium-phpunit-cache"
		 xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd">
	<testsuite name="Atrium core">
		<directory>lib/Agent</directory>
		<directory>lib/Authentication/Scope</directory>
		<file>lib/Authentication/Login/AgentLoginBlockCommandTest.php</file>
		<file>lib/AppFramework/Middleware/Security/ScopeMiddlewareTest.php</file>
		<file>Core/Controller/AtriumAgentControllerTest.php</file>
	</testsuite>
</phpunit>
